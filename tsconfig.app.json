{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@pages/*": ["pages/*"],
      "@containers/*": ["containers/*"],
      "@components/*": ["components/*"],
      "@contexts/*": ["contexts/*"],
      "@hooks/*": ["hooks/*"],
      "@constants/*": ["constants/*"],
      "@models/*": ["models/*"],
      "@service/*": ["services/*"],
      "@ui/*": ["ui/*"],
      "@assets/*": ["assets/*"],
      "@routes/*": ["routes/*"]
    },
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src"]
}
